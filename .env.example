# Chave da API da Anthropic (console.anthropic.com) — obrigatória para gerar roteiros
ANTHROPIC_API_KEY=

# Chave do Apify (console.apify.com) — habilita os virais de TikTok e Instagram.
# Tem plano gratuito com créditos mensais. Opcional, mas recomendado.
APIFY_API_TOKEN=

# Chave da YouTube Data API v3 (Google Cloud Console) — sinal complementar. Opcional.
YOUTUBE_API_KEY=

# ── Estado compartilhado (Supabase) — opcional ──────────────────────────
# Sem estas duas, cada navegador guarda as próprias marcações e apagar uma
# ideia só vale naquele aparelho. Com elas, vale para todos.
# Pegue em Settings → API Keys do seu projeto. A SECRET é a secreta
# (sb_secret_...), nunca a publicável — ela some do navegador de propósito.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
